#!/usr/bin/env bash
# ut99 — single wrapper for the whole project: dedicated server, game client,
# tailcat bridges (with the datagram-framed UDP relay in scripts/ut99-bridge.py),
# LAN-only play, prefix packing, dependency install.
#
#   ut99 server  [game options] [tunnel options]   server (+ internet bridge)
#   ut99 client  [tcp...] [tunnel options]           game (+ internet bridge)
#   ut99 bridge  host|client ...                    bridges only
#   ut99 probe   [port]                             net-test a listening server
#   ut99 pack / deploy / file-serve / file-pull / deps   prefix tarball helpers
#   ut99 --completion bash                          bash completion script
#   ut99 help                                       this list
#
# Direct LAN play: `ut99 server --lan`, then clients join host-ip:7777
# (or `ut99 client` on the host machine itself).
# Internet play:   `ut99 server` prints a tcp... address; each friend runs
#                  `ut99 client <tcp...>` — the bridge starts with the game and
#                  one Ctrl+C stops both.
#
# Every setting is also available as the documented environment variables
# (see README); this wrapper just maps flags onto them.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
S="$ROOT/scripts"
# Shared env defaults (WINEPREFIX/UT_DIR/ports/...).  Everything is :-based,
# so flags/exported vars set below still win.
source "$ROOT/helpers/ut99-env.sh"

usage() {
  # ANSI accents: commands in bold cyan, section headers bold.  Plain text
  # when stdout is not a terminal (pipes, redirects — alignment is identical).
  if [ -t 1 ]; then
    local B=$'\e[1m' K=$'\e[1;36m' R=$'\e[0m'
  else
    local B='' K='' R=''
  fi
  cat <<EOF
${B}ut99${R} — Unreal Tournament 99 over LAN or the internet (tailcat + framed UDP relay)

${B}USAGE${R}
  ${K}ut99 server${R}  [options]        Dedicated server. Default also starts the
                                tailcat host bridge and prints the tcp...
                                address; the host player joins with \`${K}ut99 client\`${R}.
  ${K}ut99 client${R}  [tcp...] [opts]   Game client. With a tcp... address it starts the
                                client bridge first, waits until the tunnel is
                                up, then launches the game (auto-joins during
                                the intro). Without an address: direct LAN join.
  ${K}ut99 bridge${R}  host [--bridge-port N] [--port N] [--tc-key NAME]
  ${K}ut99 bridge${R}  client <tcp...> [--bridge-port N] [--host-port N] [--port N] [--tc-key NAME]
                                Run only one side of the bridge (separate terminals).
  ${K}ut99 probe${R}   [port]           Send a net-test datagram to 127.0.0.1:port
                                (default 7777); a reply proves server/bridge up.
  ${K}ut99 pack${R}    [--out PATH] [--keep LIST] [--prefix DIR]
                                Packs the wine prefix; scrubs the player name
                                out of User.ini in the packed copy (key
                                bindings and settings are kept).
  ${K}ut99 deploy${R}  [--tgz PATH] [--prefix DIR] [--force]
  ${K}ut99 file-serve${R} [DIR] [--dir DIR] [--tc-key NAME]
                                Serve DIR (default ./files: the tgz + .sha256)
                                read-only over tailcat's file service; friends
                                fetch it with tailcat cp (see command help).
  ${K}ut99 file-pull${R} <tcp...> [--dir DIR] [--tgz NAME] [--force] [--no-verify]
                          [--deploy]
                                Fetch the tgz + .sha256 from a host's file-serve
                                into files/ and verify it (skips the download
                                when the local copy already matches; see help).
  ${K}ut99 deps${R}                     install tailcat + python3 if missing,
                                check wine presence (see help)
  ${K}ut99 --completion bash${R}        bash completion script:
                                source <(./ut99 --completion bash)

${B}SERVER game options${R}
  --map NAME            Map to start on                     (default CTF-Face)
  --mode ctf|dm|instagib|team|dom
                        Game mode preset (pure presets, no mutators)
  --instagib            Add the InstaGib mutator to any mode (ctf/dm/team/dom)
  --game CLASS          Override the mode mapping entirely, e.g. Botpack.TeamGamePlus
  --mutators a,b,c      Additional mutators (InstaGib via --instagib)
  --bots N              Bot fill up to N players            (default 4)
  --skill 0-7           Game/bot difficulty written to [Botpack.ChallengeBotInfo]
                        0-3 = novice mode, 4-7 = same levels without it (default 3)
  --goal N              Score goal: FragLimit in dm modes, GoalTeamScore in
                        team modes (default 5)
  --time MIN            TimeLimit in minutes                (default 15)
  --no-ini              Don't write the game options into UnrealTournament.ini
                        NOTE: ut99 writes --bots/--goal/--time/--skill into the
                        ini, and only --goal/--time also reach the map URL (as
                        ?FragLimit/?TimeLimit, the only game options a Botpack
                        game class reads from a URL).  --bots has no URL option:
                        MinPlayers is a globalconfig key of [Botpack.DeathMatchPlus].
                        With --no-ini, --bots and --skill do nothing at all.
  --opts RAW            Full raw URL options, e.g. '?FragLimit=10?TimeLimit=20'
                        — overrides ALL of the above assembly (incl. ini writes)
  --keep-uplinks        Do NOT comment out master-server uplink lines

${B}Networking options (server)${R}
  --lan                 Server only, no bridges (plain LAN game on UDP 7777)
  --port N              Server UDP port (default 7777); the host bridge follows
  --bridge-port N       Host bridge TCP port                (default 8777)
  --tc-key NAME         Saved tailcat key name (stable tcp... address; auto-created on first use)
  --admin               Enable UT99's built-in web admin (UTServerAdmin) on the
                        running server; the host bridge serves that port too, so
                        friends can open the admin pages too.  See docs/admin-api.md
  --admin-port N        Web admin HTTP port                 (default 8080)
  --admin-pass PASS     Admin password (user 'admin').  Default: a random one,
                        printed on startup.  An empty ini AdminPassword would let
                        anyone through, so ut99 always sets one.

${B}Networking options (client)${R}
  --lan                 No bridge; join directly (default target 127.0.0.1:port)
  --join HOST:PORT      Explicit join target instead of the auto-join default
  --name NAME           Player name written to [DefaultPlayer] in User.ini.
                        Default when omitted: a random Player-XXXX. Max 16
                        characters (the engine's PlayerName limit).
  --port N              Local UDP port the client uses/joins (default 7777)
  --bridge-port N       Client-side bridge TCP port          (default 8777)
  --host-port N         Host bridge TCP port it connects to  (default 8777)
  --tc-key NAME         Saved tailcat key name (stable tcp... address; auto-created on first use)
  --no-join             Start at the main menu instead of auto-joining
  --admin               Open the host's web admin locally: forwards the host's
                        admin port to http://127.0.0.1:<--admin-port>/ServerAdmin/
  --admin-port N        Local port for the forwarded admin UI (default 18080)
  --host-admin-port N   Host's admin port (default 8080; match the server's)
  --xvfb / --no-xvfb    Force / forbid running the game under Xvfb. Default:
                        automatic when DISPLAY is unset (headless sessions).
  --xvfb-res WxH        Xvfb screen size (default 2560x1440 = the game's
                        FullscreenViewport in UnrealTournament.ini; depth is
                        fixed at 24-bit — Xvfb here refuses 32-bit screens)
  -- ARGS               Everything after '--' is passed to the game untouched

${B}Options valid on server/client/deploy/pack${R}
  --prefix DIR          WINEPREFIX override (all four)
  --wine-bin PATH       wine binary override (server/client)
EOF
}

err() { echo "ut99: $*" >&2; }

need_int() {   # need_int <name> <value> — integer check
  [[ "$2" =~ ^[0-9]+$ ]] || { err "$1 needs a number, got: $2"; exit 2; }
}

# ini_set() lives in helpers/ut99-env.sh (used here and by host-pack-prefix.sh).

# ---- shared trap for combined (server+bridge / bridge+game) modes ----------
# What we started in combined mode decides what cleanup is allowed to touch.
STARTED_SERVER=0 STARTED_BRIDGE=0 STARTED_GAME=0

kill_tree() {   # kill_tree <pid> <TERM|KILL>
  local pid="$1" sig="$2" c
  for c in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$c" "$sig"; done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# NOTE: 'pgrep/pkill -x' matches the kernel comm, which is truncated to 15
# chars — 'UnrealTournament.exe' shows up as 'UnrealTournamen'.  Match that
# plus the full command line ('-f'), which our own scripts' cmdlines never contain.
#
# '-g 0' limits every kill to OUR OWN process group.  Wine re-parents the game
# to init (wineserver adopts it) but the group is inherited from us, so a
# group-scoped kill still reaches it — while leaving a second ut99 run's game
# alone.  That matters on one machine: a loopback test's server and client
# share the same wine prefix, and the client's cleanup must not end the
# server's match.
wine_kill() {   # wine_kill <TERM|KILL>
  pkill "$1" -g 0 -x UCC.exe 2>/dev/null || true
  pkill "$1" -g 0 -x UnrealTournamen 2>/dev/null || true
  pkill "$1" -g 0 -f 'UnrealTournament\.exe' 2>/dev/null || true
  pkill "$1" -g 0 -x wineserver 2>/dev/null || true
}
wine_alive() {  # wine_alive [group] — machine-wide, or only our own group
  local g=""
  [ "${1:-}" = group ] && g="-g 0"
  pgrep $g -x UCC.exe >/dev/null 2>&1 \
    || pgrep $g -x UnrealTournamen >/dev/null 2>&1 \
    || pgrep $g -f 'UnrealTournament\.exe' >/dev/null 2>&1
}
# other_ut99_alive — is another ut99 wrapper running in a DIFFERENT process
# group (the other side of a loopback test)?  Our own wrapper and its job
# subshells share our group and do not count.
other_ut99_alive() {
  local mine other p
  mine="$(ps -o pgid= -p "$$" 2>/dev/null | tr -d ' ')"
  for p in $(pgrep -f 'ut99 (server|client|bridge)' 2>/dev/null); do
    other="$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')"
    [ -n "$other" ] && [ "$other" != "$mine" ] && return 0
  done
  return 1
}

combined_cleanup() {
  err "Stopping ut99 processes..."
  local job
  # Use our own recorded PIDs, not live 'jobs -p': bash may reap a finished
  # job before the KILL pass runs, orphaning SIGTERM-immune tailcat.
  for job in "${started_jobs[@]}"; do kill_tree "$job" TERM; done
  sleep 1.5
  for job in "${started_jobs[@]}"; do kill_tree "$job" KILL; done
  # tailcat inherits SIG_IGN and only ever dies to SIGKILL. It is normally a
  # direct descendant of our jobs (tailcat_exec), but if the script shell
  # exited first the job pid is already reaped and the tree KILL above misses
  # it — so SIGKILL everything tailcat inside *our own process group*. Group
  # scoping makes this safe for the other side of a loopback test or any
  # other tailcat user on the machine.
  if [ "$STARTED_BRIDGE" = 1 ]; then
    pkill -KILL -g 0 -x tailcat 2>/dev/null || true
  fi
  if [ "$STARTED_SERVER" = 1 ] || [ "$STARTED_GAME" = 1 ]; then
    wine_kill TERM
    sleep 1.5
    wine_kill KILL
    # A game is still running and it is not in our group: some run of ours (or
    # of an older version) escaped cleanup.  Kill it machine-wide, but never
    # while another ut99 run on this machine may still be playing.
    if wine_alive && ! other_ut99_alive; then
      err "cleaning up stray UT processes"
      pkill -KILL -x UCC.exe 2>/dev/null || true
      pkill -KILL -x UnrealTournamen 2>/dev/null || true
      pkill -KILL -f 'UnrealTournament\.exe' 2>/dev/null || true
      pkill -KILL -x wineserver 2>/dev/null || true
    fi
  fi
}
combined_traps() { trap combined_cleanup EXIT INT TERM; }

# job_pipe <label> <cmd...> — run a child, prefix its output, background it
# NOTE: the backgrounded subshell intentionally INHERITS our EXIT trap: when
# one job of a combined run dies (game leaves, bridge drops), its trap runs
# combined_cleanup inside the subshell and tears down the sibling job right
# away.  That is why 'Stopping ut99 processes...' can show up twice — the
# cleanup is idempotent, so running it a second time is harmless.
started_jobs=()
job_pipe() {
  local label="$1"; shift
  ( "$@" 2>&1 | awk -v tag="[$label] " '{print tag $0; fflush()}' ) &
  started_jobs+=($!)
}

# monitor_jobs — stay alive while any backgrounded job lives; exit as soon as
# none do (or, in two-job combined mode, as soon as either dies so the EXIT
# trap cleans up the other). Polls instead of 'wait' because bash defers
# trapped signals inside plain 'wait'.
monitor_jobs() {
  local pids p alive miss=0
  while :; do
    pids=($(jobs -p)); alive=0
    for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && { alive=1; break; }; done
    [ "$alive" = 1 ] || break
    # Wine pipe-leak guard: wine's persistent services.exe inherits the game's
    # stdout, so its end of our output pipeline stays open after the game
    # itself dies (crash, disconnect, or the other side of a loopback test).
    # The job would then live forever and make 'ut99 server' look like the
    # match were still running.  Once a game run has definitively lost its
    # game process, treat the jobs as finished after a short grace period
    # (long enough for wine to spawn UCC.exe / the game at startup).
    if { [ "$STARTED_SERVER" = 1 ] || [ "$STARTED_GAME" = 1 ]; } && ! wine_alive group; then
      miss=$((miss+1))
      [ "$miss" -ge 6 ] && break
    else
      miss=0
    fi
    sleep 1
  done
}

# ---- ut99 server ------------------------------------------------------------
cmd_server() {
  local map=CTF-Face mode=ctf insta=0 game_type="" mutators="" raw_opts=""
  local bots=4 skill=3 goal=5 time=15 lan=0 port="" bridge_port=""
  local uplinks=1 ini=1 m
  local admin=0 admin_port="${UT99_ADMIN_PORT:-8080}" admin_pass="${UT99_ADMIN_PASS:-}"
  local ini_file="$UT_DIR/UnrealTournament.ini"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --map)      map="$2"; shift 2 ;;
      --mode)     mode="$2"; shift 2 ;;
      --instagib) insta=1; shift ;;
      --game)     game_type="$2"; shift 2 ;;
      --mutators) mutators="$2"; shift 2 ;;
      --opts)     raw_opts="$2"; shift 2 ;;
      --bots)     bots="$2"; need_int --bots "$bots"; shift 2 ;;
      --skill)    skill="$2"; need_int --skill "$skill"; shift 2 ;;
      --goal)     goal="$2"; need_int --goal "$goal"; shift 2 ;;
      --time)     time="$2"; need_int --time "$time"; shift 2 ;;
      --lan)      lan=1; shift ;;
      --port)     port="$2"; need_int --port "$port"; shift 2 ;;
      --bridge-port) bridge_port="$2"; need_int --bridge-port "$bridge_port"; shift 2 ;;
      --tc-key)   export TAILCAT_KEY="$2"; shift 2 ;;
      --keep-uplinks) uplinks=0; shift ;;
      --no-ini)   ini=0; shift ;;
      --admin)    admin=1; shift ;;
      --admin-port) admin_port="$2"; need_int --admin-port "$admin_port"; shift 2 ;;
      --admin-pass) admin_pass="$2"; shift 2 ;;
      --prefix)   export WINEPREFIX="$2"; shift 2 ;;
      --wine-bin) export WINE_BIN="$2"; shift 2 ;;
      -h|--help)  sed -n '/^SERVER game options/,/^Networking options (server)/p' <<EOF
SERVER game options
  --map NAME  --mode ctf|dm|instagib|team|dom  --instagib  --game CLASS
  --mutators a,b  --opts RAW  --bots N  --skill 0-7  --goal N  --time MIN
  --no-ini  --keep-uplinks   --lan  --port N  --bridge-port N  --tc-key NAME
  --admin  --admin-port N  --admin-pass PASS   --prefix DIR  --wine-bin PATH
EOF
        exit 0 ;;
      *) err "unknown server option: $1"; exit 2 ;;
    esac
  done

  # mode → game class mapping (pure presets; --game wins outright)
  if [ -z "$game_type" ]; then
    case "$mode" in
      ctf)      game_type="Botpack.CTFGame" ;;
      dm)       game_type="Botpack.DeathMatchPlus" ;;
      instagib) game_type="Botpack.DeathMatchPlus"; insta=1 ;;
      team)     game_type="Botpack.TeamGamePlus" ;;
      dom)      game_type="Botpack.Domination" ;;
      *) err "--mode must be ctf|dm|instagib|team|dom (or use --game CLASS)"; exit 2 ;;
    esac
  fi

  # build ?Mutator=... from --instagib and --mutators
  local mut=()
  [ "$insta" = 1 ] && mut+=("Botpack.InstaGibDM")
  if [ -n "$mutators" ]; then
    IFS=',' read -r -a m <<< "$mutators"
    for m in "${m[@]}"; do [ -n "$m" ] && mut+=("$m"); done
  fi

  # ini section + goal key for this game class, checked against the shipped
  # 469 Botpack sources (Botpack/DeathMatchPlus.uc, TeamGamePlus.uc, CTFGame.uc):
  #   MinPlayers  globalconfig, declared in DeathMatchPlus  -> the engine only
  #               ever reads it from [Botpack.DeathMatchPlus], never from a URL.
  #   TimeLimit   config, declared in DeathMatchPlus        -> plain config keys
  #   FragLimit   config, declared in DeathMatchPlus           are read from the
  #               section of the class actually running the game.
  #   GoalTeamScore config float, declared in TeamGamePlus  -> goal key of the
  #               team games; CTFGame.InitGame() hard-sets FragLimit = 0.
  # DeathMatchPlus.InitGame() parses only FragLimit/TimeLimit/MaxCommanders
  # (+CoopWeaponMode, Tournament) out of the map URL — --bots/--skill have no
  # URL option at all and work through the ini block below.
  local sec="$game_type"
  [[ "$sec" == *.* ]] || sec="Botpack.$sec"   # ini sections are package-qualified
  local fam=dm goal_key=FragLimit
  case "$sec" in
    Botpack.CTFGame|Botpack.TeamGamePlus|Botpack.Domination|Botpack.Assault)
      fam=team goal_key=GoalTeamScore ;;
  esac

  local extra=""
  if [ -n "$raw_opts" ]; then
    extra="$raw_opts"                       # full passthrough wins
  else
    [ "${#mut[@]}" -gt 0 ] && extra+="?Mutator=$(IFS=+; echo "${mut[*]}")"
    # ?TimeLimit and ?FragLimit (DM family only) are the options the game class
    # really reads.  URL options apply to the map being started only, so the
    # same numbers are written into the ini below and survive a map change.
    extra+="?TimeLimit=$time"
    [ "$fam" = dm ] && extra+="?FragLimit=$goal"
  fi
  if [ -n "$port" ]; then
    export UT_UDP_PORT="$port"
    [ -z "$raw_opts" ] && extra+="?port=$port"   # tell UCC to bind this port
  fi
  [ -n "$bridge_port" ] && export BRIDGE_TCP_PORT="$bridge_port"
  export MAP="$map" GAME_TYPE="$game_type" EXTRA_OPTS="$extra" DISABLE_UPLINKS="$uplinks"

  if [ "$ini" = 1 ] && [ -z "$raw_opts" ]; then
    # Write the options into the ini too: they are what decides a map change
    # (server.nextmap), and they are the only way --bots and --skill reach the
    # game at all.  Keys are replaced in place; nothing else is touched.
    if [ ! -f "$ini_file" ]; then
      err "ut99 server: no $ini_file — cannot write game options (check UT_DIR/--prefix); bots/goal/time ignored"
    else
      # MinPlayers goes to [Botpack.DeathMatchPlus] whatever the mode is,
      # because that is where the property is declared and it is `globalconfig`
      # (measured: [Botpack.CTFGame] MinPlayers=4 was ignored, ngLog logged
      # MultiPlayerBots False = MinPlayers 0, and no bot ever spawned).
      ini_set "$ini_file" Botpack.DeathMatchPlus MinPlayers "$bots"
      ini_set "$ini_file" "$sec" TimeLimit "$time"
      ini_set "$ini_file" "$sec" "$goal_key" "$goal"
      # Bot skill: SpawnBot() re-reads `Difficulty = BotConfig.Difficulty` for
      # every bot, so the only value that matters is ChallengeBotInfo's ini key
      # (0..3 novice levels, 4..7 the same levels without novice mode).
      ini_set "$ini_file" Botpack.ChallengeBotInfo Difficulty "$skill"
      # GoalScore is not a property of any shipped game class (the real keys are
      # FragLimit and GoalTeamScore); drop it where older ut99 versions wrote it.
      ini_unset "$ini_file" "$sec" GoalScore
      ini_unset "$ini_file" Botpack.DeathMatchPlus GoalScore
      err "ut99 server: ini written: [Botpack.DeathMatchPlus] MinPlayers=$bots, [$sec] $goal_key=$goal TimeLimit=$time, [Botpack.ChallengeBotInfo] Difficulty=$skill (--no-ini to skip)"
    fi
  fi

  if [ "$admin" = 1 ]; then
    # 469 built-in web admin: UTServerAdmin served by the engine's
    # UWeb.WebServer (HTTP Basic auth).  It controls the RUNNING match:
    # switch map/game type, kick and ban players, mutators, server options,
    # and the console page — which executes any server console command, e.g.
    # 'set botpack.deathmatchplus MinPlayers N' fills the match with bots
    # live (see docs/admin-api.md for what does and does not react live).
    if [ ! -f "$ini_file" ]; then
      err "ut99 server: no $ini_file — cannot enable web admin"
    else
      [ -z "$admin_pass" ] && admin_pass="$(LC_ALL=C tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 12)"
      ini_set "$ini_file" UWeb.WebServer bEnabled True
      ini_unset "$ini_file" UWeb.WebServer Listenport   # shipped lowercase twin
      ini_set "$ini_file" UWeb.WebServer ListenPort "$admin_port"
      ini_set "$ini_file" UTServerAdmin.UTServerAdmin AdminUsername admin
      ini_set "$ini_file" UTServerAdmin.UTServerAdmin AdminPassword "$admin_pass"
      export UT99_ADMIN_PORT="$admin_port"
      err "ut99 server: web admin ON http://127.0.0.1:$admin_port/ServerAdmin/  (login: admin / $admin_pass)"
      err "ut99 server: live map/game switching, kicks and bot control — see docs/admin-api.md"
    fi
  fi

  echo "ut99 server: map=$map game=$game_type opts=$extra lan=$lan"

  combined_traps
  STARTED_SERVER=1
  if [ "$lan" = 1 ]; then
    job_pipe server "$S/host-start-server.sh"
    # Primary IPv4 of this machine (the 'src' of the default route) — the
    # address LAN friends have to type.
    local lip
    lip="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([^ ]*\).*/\1/p' | head -1)"
    echo "LAN game on UDP :${UT_UDP_PORT}. Friends on the same network join with:"
    echo "  ./ut99 client --lan --join ${lip:-<server-ip>}:${UT_UDP_PORT}"
    echo "(from this same machine:  ./ut99 client --lan)"
    monitor_jobs
    return
  fi

  STARTED_BRIDGE=1
  job_pipe server "$S/host-start-server.sh"
  # Same job_pipe pattern (prefixed output), but the awk additionally watches
  # for tailcat's 'listening ... address: tcp...' line and prints a ready-to-
  # copy join command built from the address tailcat actually generated.
  ( "$S/host-start-bridge.sh" 2>&1 \
    | awk -v tag='[bridge] ' -v key="$TAILCAT_KEY" '
        { print tag $0; fflush() }
        !found && /listening with/ {
          for (i = 1; i <= NF; i++)
            if ($i ~ /^tcp[A-Za-z0-9_-]+$/) { addr = $i; found = 1 }
          if (found) {
            print tag "Friends join with:"
            print tag "  ./ut99 client " addr
            if (key != "")
              print tag "(pass --tc-key " key " again to get this same address back on restart)"
            print tag "You (this machine):  ./ut99 client"
            fflush()
          }
        }' ) &
  started_jobs+=($!)
  echo "Combined mode: server + tailcat bridge. Ctrl+C stops both."
  monitor_jobs
}

# ---- ut99 client ------------------------------------------------------------
cmd_client() {
  local tc="" lan=0 join="" name="" port="" bridge_port="" host_port="" nojoin=0
  local admin=0 admin_local="${UT99_ADMIN_LOCAL:-18080}" host_admin="${UT99_HOST_ADMIN_PORT:-8080}"
  local xvfb="" xvfb_res="${UT99_XVFB_RES:-2560x1440}"
  local game_args=() game_cmd=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lan)     lan=1; shift ;;
      --join)    join="$2"; shift 2 ;;
      --name)    name="$2"; shift 2 ;;
      --port)    port="$2"; need_int --port "$port"; shift 2 ;;
      --bridge-port) bridge_port="$2"; need_int --bridge-port "$bridge_port"; shift 2 ;;
      --host-port) host_port="$2"; need_int --host-port "$host_port"; shift 2 ;;
      --tc-key)  export TAILCAT_KEY="$2"; shift 2 ;;
      --no-join) nojoin=1; shift ;;
      --admin)   admin=1; shift ;;
      --admin-port) admin_local="$2"; need_int --admin-port "$admin_local"; shift 2 ;;
      --host-admin-port) host_admin="$2"; need_int --host-admin-port "$host_admin"; shift 2 ;;
      --xvfb)    xvfb=1; shift ;;
      --no-xvfb) xvfb=0; shift ;;
      --xvfb-res) xvfb_res="$2"; shift 2 ;;
      --prefix)  export WINEPREFIX="$2"; shift 2 ;;
      --wine-bin) export WINE_BIN="$2"; shift 2 ;;
      -h|--help) sed -n '/^Networking options (client)/,/^Options valid/p' <<EOF
Networking options (client)
  --lan  --join HOST:PORT  --name NAME  --port N  --bridge-port N  --host-port N
  --tc-key NAME  --no-join  --xvfb/--no-xvfb  --xvfb-res WxH
  --admin  --admin-port N  --host-admin-port N
  -- ARGS (passed to the game)  --prefix DIR  --wine-bin PATH
EOF
        exit 0 ;;
      --)        shift; game_args=("$@"); break ;;
      tc*)       tc="$1"; shift ;;
      *) err "unknown client option or missing tcp... address: $1"; exit 2 ;;
    esac
  done

  [ -n "$port" ] && export UT_UDP_PORT="$port"
  [ -n "$bridge_port" ] && export BRIDGE_TCP_PORT="$bridge_port"
  [ -n "$host_port" ] && export HOST_BRIDGE_TCP_PORT="$host_port"
  [ "$nojoin" = 1 ] && export UT_AUTOJOIN=0

  local ut_udp_port="${UT_UDP_PORT:-7777}"

  # Player name: the engine reads it from [DefaultPlayer] Name in User.ini and
  # puts it in the join URL (?Name=...) when browsing a server. With --name the
  # user picks it; without one we generate a throwaway Player-XXXX so ut99
  # players show up with a plain default name instead of whatever the prefix's
  # User.ini happens to contain. The engine caps PlayerName at 16 characters.
  if [ -z "$name" ]; then
    name="Player-$(( 1000 + RANDOM % 9000 ))"
  fi
  # ? and = are URL/ini option separators, ' is quote-breakage; newlines
  # cannot occur inside a single shell argument.
  case "$name" in
    *[\?=\"\']*) err "invalid player name (contains ? = \" or '): $name"; exit 2 ;;
  esac
  if [ "${#name}" -gt 16 ]; then
    err "player name truncated to 16 chars: ${name:0:16}"
    name="${name:0:16}"
  fi
  if [ ! -f "$UT_DIR/User.ini" ]; then
    err "note: $UT_DIR/User.ini did not exist; created it (the game fills in the rest on first save)."
    : > "$UT_DIR/User.ini"
  fi
  ini_set "$UT_DIR/User.ini" DefaultPlayer Name "$name"
  echo "Player name: $name  ([DefaultPlayer] Name in $UT_DIR/User.ini)"

  # Xvfb for the game window: explicit flag wins; otherwise automatic when
  # there is no DISPLAY (e.g. ssh/headless sessions). Depth is x24: Xvfb on
  # this system refuses x32 screens ("Couldn't add screen 0"), and wine maps
  # a 24-bit root window to 32-bit rendering the same way any real desktop
  # does. Keep the resolution equal to the game's FullscreenViewportX/Y in
  # UnrealTournament.ini — a mismatch makes the swapchain resize and wine
  # dies with an X BadWindow error during startup.
  if [ -z "$xvfb" ] && [ -z "${DISPLAY:-}" ]; then xvfb=1; fi
  if [ "$xvfb" = 1 ]; then
    command -v xvfb-run >/dev/null || { err "xvfb-run not found (install xvfb) — or use --no-xvfb to try DISPLAY=$DISPLAY directly."; exit 1; }
    game_cmd=(xvfb-run -a -s "-screen 0 ${xvfb_res}x24")
    err "Game window on Xvfb ${xvfb_res}x24 (use --no-xvfb to force your DISPLAY)."
  fi

  if [ -z "$tc" ] || [ "$lan" = 1 ]; then
    # direct LAN client: no bridge
    combined_traps
    STARTED_GAME=1
    [ -n "$join" ] && game_args=("$join" "${game_args[@]}")
    if [ "$admin" = 1 ]; then
      # On a LAN there is nothing to forward: the host's web admin is directly
      # reachable (the host enabled it with 'ut99 server --admin').
      err "ut99 client: web admin at http://${join%%:*}:${host_admin}/ServerAdmin/ (ask the host for the login)"
    fi
    job_pipe game "${game_cmd[@]+"${game_cmd[@]}"}" "$S/client-start-ut99.sh" "${game_args[@]+"${game_args[@]}"}"
    monitor_jobs
    return
  fi

  # remote client: bridge + game combined
  combined_traps
  STARTED_BRIDGE=1
  job_pipe bridge "$S/client-start-bridge.sh" "$tc"

  # wait until the bridge's UDP listener is actually up before auto-joining
  local up=0 i
  for i in $(seq 1 60); do
    ss -lun 2>/dev/null | grep -qE "[:.]${ut_udp_port}( |$)" && { up=1; break; }
    kill -0 "$(jobs -p | sed -n 1p)" 2>/dev/null || break
    sleep 0.5
  done
  if [ "$up" != 1 ]; then
    err "client bridge never bound UDP :${ut_udp_port} — check the tcp... address and the host."
    exit 1
  fi

  if [ "$admin" = 1 ]; then
    # Remote admin access: forward the host's web-admin port to a local port so
    # the admin pages open in a browser here.  It runs as its OWN tailcat
    # forward (not folded into the bridge's) and with the traps cleared, so a
    # failure — a local port clash, or the host never enabled --admin — cannot
    # tear down the game run; cleanup still reaps it through started_jobs.
    ( trap - EXIT INT TERM
      tailcat_exec forward "$tc" "${admin_local}:${host_admin}" 2>&1 \
        | awk -v tag='[admin] ' '{print tag $0; fflush()}' ) &
    started_jobs+=($!)
    err "ut99 client: host web admin -> http://127.0.0.1:${admin_local}/ServerAdmin/  (host must have started with --admin; login from the host)"
  fi

  if [ -n "$join" ]; then
    game_args=("$join" "${game_args[@]}")
  fi
  echo "ut99 client: bridge up on UDP :${ut_udp_port}, launching game (auto-join unless --no-join)."
  STARTED_GAME=1
  job_pipe game "${game_cmd[@]+"${game_cmd[@]}"}" "$S/client-start-ut99.sh" "${game_args[@]+"${game_args[@]}"}"
  monitor_jobs
}

# ---- ut99 bridge ------------------------------------------------------------
cmd_bridge() {
  local side="${1:-}"; shift || true
  case "$side" in
    host)
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --bridge-port) export BRIDGE_TCP_PORT="$2"; need_int --bridge-port "$2"; shift 2 ;;
          --port)        export UT_UDP_PORT="$2"; need_int --port "$2"; shift 2 ;;
          --tc-key)      export TAILCAT_KEY="$2"; shift 2 ;;
          *) err "unknown bridge host option: $1"; exit 2 ;;
        esac
      done
      exec "$S/host-start-bridge.sh" ;;
    client)
      local tc="${1:-}"; [ $# -gt 0 ] && shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --bridge-port) export BRIDGE_TCP_PORT="$2"; need_int --bridge-port "$2"; shift 2 ;;
          --host-port)   export HOST_BRIDGE_TCP_PORT="$2"; need_int --host-port "$2"; shift 2 ;;
          --port)        export UT_UDP_PORT="$2"; need_int --port "$2"; shift 2 ;;
          --tc-key)      export TAILCAT_KEY="$2"; shift 2 ;;
          *) err "unknown bridge client option: $1"; exit 2 ;;
        esac
      done
      exec "$S/client-start-bridge.sh" ${tc:+"$tc"} ;;
    *) err "usage: ut99 bridge host|client ..."; exit 2 ;;
  esac
}

# ---- ut99 probe --------------------------------------------------------------
cmd_probe() {
  local port="${1:-7777}"
  need_int probe "$port"
  python3 - "$port" <<'PYEOF'
import socket, sys
port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.settimeout(5)
s.sendto(b'\x00\x01\x00\x00\x00UUnreal', ('127.0.0.1', port))
try:
    data, addr = s.recvfrom(2048)
    print(f"reply from {addr}: {data!r}  -> server reachable through UDP :{port}")
except TimeoutError:
    sys.exit(f"no reply on UDP :{port} — server or bridge not up?")
PYEOF
}

# ---- ut99 pack / deploy / deps ----------------------------------------------
cmd_pack() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --out)    export UT99_PACK_OUT="$2"; shift 2 ;;
      --keep)   export UT99_PACK_KEEP="$2"; shift 2 ;;
      --prefix) export WINEPREFIX="$2"; shift 2 ;;
      *) err "unknown pack option: $1"; exit 2 ;;
    esac
  done
  exec "$S/host-pack-prefix.sh"
}

cmd_deploy() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tgz)    export UT99_PREFIX_TGZ="$2"; shift 2 ;;
      --prefix) export WINEPREFIX="$2"; shift 2 ;;
      --force)  export UT99_DEPLOY_FORCE=1; shift ;;
      *) err "unknown deploy option: $1"; exit 2 ;;
    esac
  done
  exec "$S/client-deploy-prefix.sh"
}

cmd_file_serve() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)    export UT99_FILE_SERVE_DIR="$2"; shift 2 ;;
      --tc-key) export TAILCAT_KEY="$2"; shift 2 ;;
      -h|--help) cat <<'EOF'
ut99 file-serve [DIR] [--dir DIR] [--tc-key NAME]
  Serves DIR (default: the repo's files/ directory) read-only through
  tailcat's files service (SFTP over tailcat; the system scp does the
  transferring). Nothing is served until this command runs.

  Friend side (their own clone/copy of this repo, on their machine):
    ./ut99 deps                                   # installs tailcat, checks python3 + wine
    mkdir -p files
    tailcat cp <tcp...>:ut99-wineprefix.tgz files/
    tailcat cp <tcp...>:ut99-wineprefix.tgz.sha256 files/
    ./ut99 deploy                                 # checksum + extract
EOF
        exit 0 ;;
      *) break ;;
    esac
  done
  exec "$S/host-serve-files.sh" "$@"
}

cmd_file_pull() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tc-key) export TAILCAT_KEY="$2"; shift 2 ;;
      -h|--help) cat <<'EOF'
ut99 file-pull <tcp...> [--dir DIR] [--tgz NAME] [--force] [--no-verify] [--deploy]
  Fetches ut99-wineprefix.tgz (+ .sha256) from a host running
  `ut99 file-serve` into files/, then verifies the checksum. The .sha256
  is pulled first, so re-running skips the download when the local copy
  already matches (--force re-fetches anyway). --deploy extracts it.

  The <tcp...> here is the host's FILE-SERVICE address, not its game
  bridge address; the address is only reachable while file-serve runs.
EOF
        exit 0 ;;
      *) break ;;
    esac
  done
  exec "$S/client-pull-files.sh" "$@"
}

# ---- bash completion ---------------------------------------------------------
cmd_completion() {
  case "${1:-bash}" in
    bash) ;;
    *) err "usage: ut99 --completion bash"; exit 2 ;;
  esac
  cat <<'EOF'
# ut99 shell completion — install with:
#   source <(./ut99 --completion bash)      # or add that line to ~/.bashrc
_ut99_completions() {
  local cur prev sub opts w
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  local SUBCMDS="server client bridge probe pack deploy file-serve file-pull deps help"
  local SUBOPTS="-h --help"

  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$SUBCMDS --completion -h --help" -- "$cur") )
    return 0
  fi
  case "${COMP_WORDS[1]}" in
    -*) COMPREPLY=( $(compgen -W "--completion -h --help" -- "$cur") ); return 0 ;;
    *)  sub="${COMP_WORDS[1]}" ;;
  esac

  # Options that take a value: complete the value instead of another flag.
  case "$prev" in
    --mode)      COMPREPLY=( $(compgen -W "ctf dm instagib team dom" -- "$cur") ); return 0 ;;
    --keep)      COMPREPLY=( $(compgen -W "mono UT436 win_installer inetcache ut_installer glcache ut_logs running_ini" -- "$cur") ); return 0 ;;
    --tc-key)    local keys; keys=$(ls "$HOME/.config/tailcat/keys"/*.private.json 2>/dev/null | sed 's#.*/##; s/\.private\.json$//'); COMPREPLY=( $(compgen -W "$keys" -- "$cur") ); return 0 ;;
    --prefix|--dir) COMPREPLY=( $(compgen -d -- "$cur") ); return 0 ;;
    --out|--tgz) COMPREPLY=( $(compgen -f -- "$cur") ); return 0 ;;
    --port|--bridge-port|--host-port|--bots|--skill|--goal|--time|--xvfb-res|--map|--game|--mutators|--opts|--join|--name) return 0 ;;
  esac

  case "$sub" in
    server)     opts="--map --mode --instagib --game --mutators --opts --bots --skill --goal --time --no-ini --keep-uplinks --lan --port --bridge-port --tc-key --admin --admin-port --admin-pass --prefix --wine-bin" ;;
    client)     opts="--lan --join --name --port --bridge-port --host-port --tc-key --no-join --admin --admin-port --host-admin-port --xvfb --no-xvfb --xvfb-res --prefix --wine-bin" ;;
    bridge)     if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=( $(compgen -W "host client" -- "$cur") ); return 0; fi
                if [ "${COMP_WORDS[2]}" = host ]; then
                  opts="--bridge-port --port --tc-key"
                else
                  opts="--bridge-port --host-port --port --tc-key"
                fi ;;
    probe)      opts="" ;;
    pack)       opts="--out --keep --prefix" ;;
    deploy)     opts="--tgz --prefix --force" ;;
    file-serve) opts="--dir --tc-key" ;;
    file-pull)  opts="--dir --tgz --force --no-verify --deploy" ;;
    deps)       opts="" ;;
    *)          opts="" ;;
  esac

  if [ "${cur:0:1}" = "-" ]; then
    COMPREPLY=( $(compgen -W "$opts $SUBOPTS" -- "$cur") )
    return 0
  fi

  # Positional arguments. Only file-serve's is a path; tailcat addresses
  # (client / file-pull) have nothing to complete against locally.
  case "$sub" in
    file-serve) COMPREPLY=( $(compgen -d -- "$cur") ) ;;
  esac
  return 0
}
complete -F _ut99_completions ut99 ./ut99
EOF
}

# ---- dispatch ----------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
  server) cmd_server "$@" ;;
  client) cmd_client "$@" ;;
  bridge) cmd_bridge "$@" ;;
  probe)  cmd_probe "$@" ;;
  pack)   cmd_pack "$@" ;;
  deploy) cmd_deploy "$@" ;;
  file-serve) cmd_file_serve "$@" ;;
  file-pull)  cmd_file_pull "$@" ;;
  completion|--completion) cmd_completion "$@" ;;
  deps)   exec "$S/install-deps.sh" "$@" ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $cmd"; echo; usage; exit 2 ;;
esac
